{
  "name": "witness",
  "version-string": "1.0.0",
  "dependencies": [
    "crow",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": ["avcodec", "avformat", "swresample", "swscale", "gpl", "x264"]
    },
    "opencv4",
    "libsodium",
    {
      "name": "onnxruntime-gpu",
      "platform": "windows"
    },
    {
      "name": "onnxruntime",
      "platform": "!windows"
    },
    {
      "name": "openssl",
      "features": ["tools"]
    },
    "sqlite3"
  ]
}