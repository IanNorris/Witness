<Window x:Class="Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="clr-namespace:System;assembly=System"
        xmlns:local="clr-namespace:Installer"
        xmlns:xctk="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
        mc:Ignorable="d"
        Title="Witness Setup" Height="450" Width="800" ResizeMode="CanMinimize">
    <Grid>
        <xctk:Wizard CurrentPage="{Binding ElementName=Login}" Finish="Wizard_Finish">
            <xctk:WizardPage x:Name="Welcome" NextPage="{Binding ElementName=Login}" Title="Configure Witness" Description="This Wizard will guide you through the process of setting up Witness for first use. You can rerun this tool again to update your setup." CanHelp="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Margin="10 10 0 10" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding RunOnStartup}">Start server with Windows (using current credentials)</CheckBox>
                    <CheckBox Margin="10 10 0 10" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding RestartOnFailure}">Restart server if a crash occurs</CheckBox>

                    <Label Margin="10 10 10 10" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0">Cache</Label>
                    <Grid Margin="10 10 10 10" Grid.Row="2" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                        <TextBox Name="Cache" Grid.Row="0" Grid.Column="0" Text="{Binding Cache}"/>
                        <Button Name="CacheBrowse"  Grid.Row="0" Grid.Column="1" Click="CacheBrowse_Click">Browse</Button>
                    </Grid>

                    <Label Margin="10 10 10 10" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0">Worker Cores</Label>
                    <xctk:WatermarkTextBox Margin="10 10 10 10" Grid.Row="3" Grid.Column="1" Text="{Binding ThreadCount}"/>

                    <Label Margin="10 10 10 10" HorizontalAlignment="Right" Grid.Row="4" Grid.Column="0">Leadin Time (s)</Label>
                    <xctk:WatermarkTextBox Margin="10 10 10 10" Grid.Row="4" Grid.Column="1" Text="{Binding ClipLeadIn}"/>

                </Grid>
            </xctk:WizardPage>

            <xctk:WizardPage x:Name="Login" NextPage="{Binding ElementName=RemoteAccess}" Title="Set your admin credentials" Description="Configure your first admin credentials. You will be able to add additional users later. You should avoid using common usernames such as admin, root or user, and instead use your own name.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0">Username</Label>
                    <xctk:WatermarkTextBox Margin="10 20 10 20" Grid.Row="0" Grid.Column="1" Watermark="Fred" Text="{Binding Username}"/>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0">Password</Label>
                    <xctk:WatermarkPasswordBox Name="Password1" Margin="10 20 10 20" Grid.Row="1" Grid.Column="1" PasswordChanged="OnPasswordChanged"/>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0">Confirm Password</Label>
                    <xctk:WatermarkPasswordBox Name="Password2" Margin="10 20 10 20" Grid.Row="2" Grid.Column="1" PasswordChanged="OnPasswordChanged"/>
                </Grid>
            </xctk:WizardPage>

            <xctk:WizardPage x:Name="RemoteAccess" NextPage="{Binding ElementName=Cameras}" Title="Configure web portal" Description="Set up the web portal for Witness. You will need to open the port you select on your router. If you select Let's Encrypt TLS, you will also need to forward port 80.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0">Hostname &amp; Port</Label>
                    <xctk:WatermarkTextBox Margin="10 20 10 20" Grid.Row="0" Grid.Column="1" Watermark="cameras.myhome.com:5152" Text="{Binding Hostname}"></xctk:WatermarkTextBox>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0">TLS Certificate</Label>
                    <ComboBox Margin="10 20 10 20" Grid.Row="1" Grid.Column="1" SelectedValue="{Binding TlsMode}" SelectedValuePath="Tag">
                        <ComboBoxItem Tag="LetsEncrypt">Let's Encrypt (Recommended)</ComboBoxItem>
                        <ComboBoxItem Tag="SelfSigned">Self-signed certificate (Automatic)</ComboBoxItem>
                        <ComboBoxItem Tag="Manual">Manual certificate management</ComboBoxItem>
                        <ComboBoxItem Tag="NoSecurity">No security</ComboBoxItem>
                    </ComboBox>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0">Certificate E-mail</Label>
                    <xctk:WatermarkTextBox Margin="10 20 10 20" Grid.Row="2" Grid.Column="1" Watermark="john@myhome.com" Text="{Binding TlsContact}"></xctk:WatermarkTextBox>
                </Grid>
            </xctk:WizardPage>

            <xctk:WizardPage x:Name="Cameras"  NextPage="{Binding ElementName=Finish}" Title="Add cameras" Description="Add Cameras to Witness. You can add more later, this is to get you started.">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0" Grid.Column="0">
                    
                    </ListView>

                    <WrapPanel Margin="0 5 0 20" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" Grid.ColumnSpan="4">
                        <Button IsEnabled="False" Width="50">Edit</Button>
                        <Button IsEnabled="False" Width="50" Margin="10 0 0 0">Delete</Button>
                        
                    </WrapPanel>
                    

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Margin="10 0 10 10" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0">Camera name</Label>
                        <xctk:WatermarkTextBox Margin="10 0 10 10" Grid.Row="0" Grid.Column="1" Watermark="Front Door"></xctk:WatermarkTextBox>

                        <Label Margin="10 0 10 10" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="2">Camera brand</Label>
                        <ComboBox Margin="10 00 10 10" Grid.Row="0" Grid.Column="3">
                            <ComboBoxItem>Hikvision</ComboBoxItem>
                            <ComboBoxItem>Custom</ComboBoxItem>
                        </ComboBox>

                        <Label Margin="10 10 10 10" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0">Hostname/IP</Label>
                        <xctk:WatermarkTextBox Margin="10 10 10 10" Grid.Row="1" Grid.Column="1" Watermark="frontdoorcam"></xctk:WatermarkTextBox>

                        <Label Margin="10 10 10 10" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="2">Port</Label>
                        <xctk:WatermarkTextBox HorizontalAlignment="Left" Margin="10 10 10 10" Width="80" Grid.Row="1" Grid.Column="3" Watermark="11236"></xctk:WatermarkTextBox>

                        <Label Margin="10 10 10 10" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0">RTSP URL</Label>
                        <TextBox IsReadOnly="True" Margin="10 10 10 10" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"/>


                        <WrapPanel Grid.Row="4" Grid.Column="0" Margin="0" HorizontalAlignment="Right" Grid.ColumnSpan="4" >
                            <Button Margin="0 0 10 0" Width="50">Test</Button>
                            <Button Width="50">Add</Button>
                        </WrapPanel>
                            
                    </Grid>
                </Grid>
                
            </xctk:WizardPage>

            <xctk:WizardPage x:Name="Finish"  CanFinish="true" Title="All done!" Description="Let's review the new setup summary.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Margin="10 0 0 0" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">You have configured:</Label>
                    
                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0">Admin username</Label>
                    <Label Margin="10 20 10 20" Grid.Row="1" Grid.Column="1">Fred</Label>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0">Remote Access</Label>
                    <Label Margin="10 20 10 20" Grid.Row="2" Grid.Column="1">Yes</Label>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0">Cameras</Label>
                    <Label Margin="10 20 10 20" Grid.Row="3" Grid.Column="1">3</Label>

                    <Label Margin="10 20 10 20" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">To confirm and complete setup, click Finish.</Label>
                </Grid>
            </xctk:WizardPage>
        </xctk:Wizard>
    </Grid>
</Window>
