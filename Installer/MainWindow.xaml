<Window x:Class="Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="clr-namespace:System;assembly=System"
        xmlns:local="clr-namespace:Installer"
        xmlns:xctk="clr-namespace:Xceed.Wpf.Toolkit;assembly=Xceed.Wpf.Toolkit"
        mc:Ignorable="d"
        Title="Witness Setup" Height="450" Width="800" ResizeMode="CanMinimize">
    <Grid>
        <xctk:Wizard CurrentPage="{Binding ElementName=Login}" Finish="Wizard_Finish">
            <xctk:WizardPage x:Name="Welcome" NextPage="{Binding ElementName=Login}" Title="Configure Witness" Description="This Wizard will guide you through the process of setting up Witness for first use. You can rerun this tool again to update your setup." CanHelp="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0">Startup mode</Label>
                    <ComboBox Name="StartupMode" Margin="10 20 10 20" Grid.Row="0" Grid.Column="1" SelectedValue="{Binding StartupMode}" SelectedValuePath="Tag">
                        <ComboBoxItem Tag="Service">Run as a Windows service (Recommended)</ComboBoxItem>
                        <ComboBoxItem Tag="Task">Run as the current user</ComboBoxItem>
                        <ComboBoxItem Tag="Manual">Don't run at startup</ComboBoxItem>
                    </ComboBox>

                    <Label Margin="10 10 10 10" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0">Cache</Label>
                    <Grid Margin="10 10 10 10" Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Name="Cache" Grid.Row="0" Grid.Column="0" Text="{Binding Cache}"/>
                        <Button Name="CacheBrowse"  Grid.Row="0" Grid.Column="1" Click="CacheBrowse_Click">Browse</Button>
                    </Grid>

                    <Label Margin="10 10 10 10" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0">Lead-in Time (sec)</Label>
                    <xctk:WatermarkTextBox Margin="10 10 10 10" Grid.Row="2" Grid.Column="1" Text="{Binding ClipLeadIn}"/>

                    <CheckBox Margin="10 20 0 10" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding RestartOnFailure}">Restart server if a crash occurs</CheckBox>
                </Grid>
            </xctk:WizardPage>

            <xctk:WizardPage x:Name="Login" NextPage="{Binding ElementName=RemoteAccess}" Title="Set your admin credentials" Description="Configure your first admin credentials. You will be able to add additional users later. You should avoid using common usernames such as admin, root or user, and instead use your own name." CanHelp="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0">Username</Label>
                    <xctk:WatermarkTextBox Name="Username" Margin="10 20 10 20" Grid.Row="0" Grid.Column="1" Watermark="Fred" Text="{Binding Username}" TextChanged="OnPasswordOrUsernameChanged" AcceptsReturn="False" KeyDown="LoginField_KeyDown"/>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0">Password</Label>
                    <xctk:WatermarkPasswordBox Name="Password1" Margin="10 20 10 20" Grid.Row="1" Grid.Column="1" PasswordChanged="OnPasswordOrUsernameChanged"  AcceptsReturn="False" KeyDown="LoginField_KeyDown"/>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0">Confirm Password</Label>
                    <xctk:WatermarkPasswordBox Name="Password2" Margin="10 20 10 20" Grid.Row="2" Grid.Column="1" PasswordChanged="OnPasswordOrUsernameChanged"  AcceptsReturn="False" KeyDown="LoginField_KeyDown"/>

                    <TextBlock Margin="10 20 10 20" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap">
                        If an account already exists, a new one will be added. Adding an account that matches an existing account will update the password for that account.
                    </TextBlock>
                </Grid>
            </xctk:WizardPage>

            <xctk:WizardPage x:Name="RemoteAccess" NextPage="{Binding ElementName=Cameras}" Title="Configure web portal" Description="Set up the web portal for Witness. For Let's Encrypt, you will need port 80 forwarded to this device." CanHelp="False">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="0">Hostname &amp; Port</Label>
                    <xctk:WatermarkTextBox Margin="10 20 10 20" Grid.Row="0" Grid.Column="1" Watermark="cameras.myhome.com:5152" Text="{Binding Hostname}"></xctk:WatermarkTextBox>

                    <Label Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="1" Grid.Column="0">TLS Certificate</Label>
                    <ComboBox Name="TlsModeCombo" Margin="10 20 10 20" Grid.Row="1" Grid.Column="1" SelectedValue="{Binding TlsMode}" SelectedValuePath="Tag" SelectionChanged="TlsModeCombo_SelectionChanged">
                        <ComboBoxItem Tag="SelfSigned">Self-signed certificate (development/testing)</ComboBoxItem>
                        <ComboBoxItem Tag="LetsEncrypt">Let's Encrypt via certbot (Recommended)</ComboBoxItem>
                        <ComboBoxItem Tag="Manual">Manual certificate (provide PEM files)</ComboBoxItem>
                        <ComboBoxItem Tag="NoSecurity">No security</ComboBoxItem>
                    </ComboBox>

                    <Label Name="TlsContactLabel" Margin="10 20 10 20" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="0">Certificate E-mail</Label>
                    <xctk:WatermarkTextBox Name="TlsContactBox" Margin="10 20 10 20" Grid.Row="2" Grid.Column="1" Watermark="john@myhome.com" Text="{Binding TlsContact}"></xctk:WatermarkTextBox>

                    <Label Name="TlsCertLabel" Margin="10 10 10 10" HorizontalAlignment="Right" Grid.Row="3" Grid.Column="0" Visibility="Collapsed">Certificate PEM</Label>
                    <xctk:WatermarkTextBox Name="TlsCertBox" Margin="10 10 10 10" Grid.Row="3" Grid.Column="1" Watermark="C:\path\to\cert.pem" Text="{Binding TlsCertPath}" Visibility="Collapsed"></xctk:WatermarkTextBox>

                    <Label Name="TlsKeyLabel" Margin="10 10 10 10" HorizontalAlignment="Right" Grid.Row="4" Grid.Column="0" Visibility="Collapsed">Private Key PEM</Label>
                    <xctk:WatermarkTextBox Name="TlsKeyBox" Margin="10 10 10 10" Grid.Row="4" Grid.Column="1" Watermark="C:\path\to\key.pem" Text="{Binding TlsKeyPath}" Visibility="Collapsed"></xctk:WatermarkTextBox>

                    <Button Name="OnConfigureRemoteAccess" Margin="10 20 10 20" HorizontalAlignment="Left" Grid.Row="5" Grid.Column="0" Padding="8 2 8 2" Click="OnConfigureRemoteAccess_Click">Configure</Button>
                </Grid>
            </xctk:WizardPage>

            <xctk:WizardPage x:Name="Finish"  CanFinish="true" Title="All done!" Description="To confirm and complete setup, click Finish.">
                
            </xctk:WizardPage>
        </xctk:Wizard>
    </Grid>
</Window>
