# Crow's synchronous write clears its stored completion callback. For a
# deferred response this callback can own the last Connection reference;
# calling it in-place frees the response during end()/response::clear().
# Retain a local copy until end() returns. Generate a build-local overlay;
# never edit the immutable vcpkg installation or force dependency rebuilds.
# Upstream context: https://github.com/CrowCpp/Crow/issues/1059 (sync writes).
get_target_property(_crow_include_dirs Crow::Crow INTERFACE_INCLUDE_DIRECTORIES)
set(_crow_response_header "")
foreach(_directory IN LISTS _crow_include_dirs)
    if(EXISTS "${_directory}/crow/http_response.h")
        set(_crow_response_header "${_directory}/crow/http_response.h")
        break()
    endif()
endforeach()
if(NOT _crow_response_header)
    message(FATAL_ERROR "Cannot locate Crow response header for reviewed async lifetime patch")
endif()
file(READ "${_crow_response_header}" _crow_response)
string(REPLACE "\r\n" "\n" _crow_response "${_crow_response}")
set(_crow_original "                if (complete_request_handler_)\n                {\n                    complete_request_handler_();")
set(_crow_fixed "                // Witness: retain Connection across synchronous callback clearing.\n                const auto completion = complete_request_handler_;\n                if (completion)\n                {\n                    completion();")
string(FIND "${_crow_response}" "${_crow_original}" _crow_match)
if(_crow_match EQUAL -1)
    message(FATAL_ERROR "Crow response implementation changed; review the async lifetime patch before building")
endif()
string(REPLACE "${_crow_original}" "${_crow_fixed}" _crow_response "${_crow_response}")
string(PREPEND _crow_response "#define WITNESS_CROW_ASYNC_RESPONSE_LIFETIME_PATCH 1\n")
set(WITNESS_CROW_ASYNC_INCLUDE "${CMAKE_BINARY_DIR}/generated/crow-async")
file(MAKE_DIRECTORY "${WITNESS_CROW_ASYNC_INCLUDE}/crow")
# Crow's top-level header uses quoted includes, which prefer its own directory
# over /I ordering. Mirror the header tree so every include (including the PCH)
# resolves consistently to the overlay; mixing response definitions is unsafe.
get_filename_component(_crow_header_dir "${_crow_response_header}" DIRECTORY)
get_filename_component(_crow_include_root "${_crow_header_dir}" DIRECTORY)
configure_file("${_crow_include_root}/crow.h" "${WITNESS_CROW_ASYNC_INCLUDE}/crow.h" COPYONLY)
file(GLOB_RECURSE _crow_headers "${_crow_header_dir}/*.h")
foreach(_header IN LISTS _crow_headers)
    if(NOT _header STREQUAL _crow_response_header)
        file(RELATIVE_PATH _relative "${_crow_include_root}" "${_header}")
        configure_file("${_header}" "${WITNESS_CROW_ASYNC_INCLUDE}/${_relative}" COPYONLY)
    endif()
endforeach()
set(_crow_output "${WITNESS_CROW_ASYNC_INCLUDE}/crow/http_response.h")
set(_crow_previous "")
if(EXISTS "${_crow_output}")
    file(READ "${_crow_output}" _crow_previous)
endif()
if(NOT _crow_previous STREQUAL _crow_response)
    file(WRITE "${_crow_output}" "${_crow_response}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_crow_response_header}")
